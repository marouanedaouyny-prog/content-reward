{
  "type": "object",
  "title": "ProductResearchInput",
  "description": "Input schema for product research workflow execution",
  "properties": {
    "scan_type": {
      "type": "string",
      "description": "Type of scan to perform",
      "enum": ["competitor", " marketplace", "trend", "price_comparison"]
    },
    "target_sites": {
      "type": "array",
      "description": "List of target websites to scan",
      "items": {"type": "string"}
    },
    "categories": {
      "type": "array",
      "description": "Product categories to focus on",
      "items": {"type": "string"}
    },
    "max_products": {
      "type": "integer",
      "description": "Maximum number of products to analyze",
      "default": 100
    },
    "include_trends": {
      "type": "boolean",
      "description": "Whether to include trend detection",
      "default": true
    }
  },
  "required": ["scan_type"],
  "additionalProperties": false
}