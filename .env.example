# Copy locally; never commit real credentials. Install .[transcription,dev] first.
CONTENT_REWARD_PROFILE=development
CLIPPING_DATABASE=data/clipping.db
CLIPPING_STORAGE=storage/clipping
CLIPPING_OUTPUT=clips
CLIPPING_TARGET_COUNT=20
CLIPPING_MAXIMUM_ATTEMPTS=3
CLIPPING_CPU_THREADS=2
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
CLIPPING_TREND_AGENT=false
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# Publishing is disabled in code and cannot be enabled with an environment flag.
