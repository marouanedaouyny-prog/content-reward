# Social Connector Environment Variables
# Copy this to .env and fill in your values

# App
APP_ENV=development
APP_SECRET=your-super-secret-key-change-in-production-min-32-chars
DATABASE_URL=sqlite:///./data/app.db
MEDIA_DIR=./data/media
LOG_DIR=./logs

# Encryption (required for token encryption)
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# API Key for service-to-service auth
API_KEY=your-api-key-here

# Base URL for OAuth callbacks
BASE_URL=http://localhost:8000
FRONT_URL=http://localhost:3000

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/v1/callback/linkedin

# Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:8000/v1/callback/facebook

# Instagram
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/v1/callback/instagram

# TikTok
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:8000/v1/callback/tiktok

# YouTube
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/v1/callback/youtube

# X (Twitter)
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
X_REDIRECT_URI=http://localhost:8000/v1/callback/x

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# API Key for service-to-service auth
API_KEY=your-api-key-here

# Scheduler
SCHEDULER_ENABLED=true
WORKER_CONCURRENCY=2

# Deploy
ALLOW_PAID_SERVICES=false
DEPLOY_MODE=local