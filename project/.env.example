# Environment Configuration
# Copy to .env and fill in your values

# App
APP_ENV=development
APP_SECRET=your-super-secret-key-change-in-production-min-32-chars
DATABASE_URL=sqlite:///./data/empire.db

# Token Encryption (REQUIRED - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_PASSWORD=your-32-char-min-password-here
TOKEN_ENCRYPTION_SALT=your-unique-salt-per-deployment

# API Key for Hermes auth
API_KEY=your-api-key-here

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/v1/callback/linkedin

# Facebook/Instagram OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/v1/callback/facebook

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/v1/callback/tiktok

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/v1/callback/youtube

# X (Twitter) OAuth
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/v1/callback/x

# Content Rewards (browser automation)
CR_EMAIL=
CR_PASSWORD=

# Whop (payouts)
WHOP_API_KEY=

# LLM APIs (free tiers)
NVIDIA_API_KEY=
OPENROUTER_API_KEY=